# CMake build trees and local build configuration.
/cmake-build-*/
/build/
/CMakeUserPresets.json
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/compile_commands.json
/build.ninja
/.ninja_deps
/.ninja_log

# Generated terrain palettes (normal builds place these inside the build tree).
/assets/terrain/runtime/

# IDE state and per-machine configuration.
/.idea/
/.env
/.env.*
!/.env.example
!/.env.sample
/.aws/

# Python tools: bytecode, environments and local caches.
__pycache__/
*.py[cod]
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Local UI state and root-level diagnostic captures.
/imgui.ini
/*.ppm

# Desktop metadata.
.DS_Store
Thumbs.db
